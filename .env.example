# Search uses Tavily keyless free access by default. Add a Tavily key for
# higher free monthly limits. Brave remains an optional alternate provider.
RESEARCH_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Optional alternate web discovery (Brave Web Search API)
BRAVE_SEARCH_API_KEY=

# Optional structured fact extraction (Gemini API)
GEMINI_API_KEY=
# Google-grounded discovery is experimental and must be selected explicitly.
# Check model availability and quota in your Google AI Studio project first.
EIA_API_KEY=
API_USGS_PAT=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SEARCH_MODEL=gemini-2.5-flash
